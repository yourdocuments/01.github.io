<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Neilusha Tour Guide | Explore Bangladesh</title>

  <meta name="description"
        content="Neilusha Tour Guide - Explore Bangladesh with trusted guides, affordable tour packages and unforgettable travel experiences.">

  <!-- ==============================
       GOOGLE FONTS
  =============================== -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@500;600;700;800&display=swap"
        rel="stylesheet">

  <!-- ==============================
       FONT AWESOME
  =============================== -->
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


<style>

/* =========================================================
   ROOT
========================================================= */

:root{

  --primary:#0ea5e9;
  --primary-dark:#0284c7;

  --navy:#071a2b;
  --navy-2:#0b263d;

  --yellow:#ffc857;

  --white:#ffffff;
  --black:#111827;

  --bg:#f5f9fc;
  --bg-2:#eef7fb;

  --text:#172333;
  --muted:#6b7b8c;

  --border:#e4edf3;

  --success:#16a34a;
  --danger:#dc2626;

  --shadow:
    0 20px 60px rgba(7,26,43,.10);

  --shadow-small:
    0 8px 25px rgba(7,26,43,.07);

  --radius:22px;

  --transition:.3s ease;

}


/* =========================================================
   RESET
========================================================= */

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{

  font-family:"Inter",sans-serif;

  color:var(--text);

  background:white;

  line-height:1.6;

  overflow-x:hidden;

}

h1,
h2,
h3,
h4,
h5{

  font-family:"Poppins",sans-serif;

}

a{

  text-decoration:none;

  color:inherit;

}

button,
input,
select,
textarea{

  font-family:inherit;

}

button{

  cursor:pointer;

}

img{

  display:block;

  width:100%;

  object-fit:cover;

}

.container{

  width:min(1180px,92%);

  margin:auto;

}


/* =========================================================
   TOP BAR
========================================================= */

.topbar{

  background:var(--navy);

  color:#dbe8f0;

  font-size:13px;

  padding:9px 0;

}

.topbar-content{

  display:flex;

  align-items:center;

  justify-content:space-between;

  gap:20px;

}

.topbar-left,
.topbar-right{

  display:flex;

  align-items:center;

  gap:22px;

}

.topbar i{

  color:var(--yellow);

  margin-right:6px;

}


/* =========================================================
   HEADER
========================================================= */

header{

  position:absolute;

  top:38px;

  left:0;

  width:100%;

  z-index:1000;

}

.navbar{

  min-height:76px;

  background:rgba(255,255,255,.97);

  backdrop-filter:blur(15px);

  border-radius:18px;

  padding:0 20px;

  display:flex;

  align-items:center;

  justify-content:space-between;

  box-shadow:0 12px 35px rgba(0,0,0,.08);

}

.logo{

  display:flex;

  align-items:center;

  gap:10px;

  color:var(--navy);

  font-family:"Poppins",sans-serif;

  font-size:20px;

  font-weight:800;

  white-space:nowrap;

}

.logo span{

  color:var(--primary-dark);

}

.logo-icon{

  width:44px;

  height:44px;

  border-radius:13px;

  background:var(--primary);

  color:white;

  display:grid;

  place-items:center;

  font-size:19px;

  transform:rotate(-4deg);

}

.nav-links{

  list-style:none;

  display:flex;

  align-items:center;

  gap:26px;

}

.nav-links a{

  position:relative;

  color:#344454;

  font-size:13px;

  font-weight:600;

  transition:var(--transition);

}

.nav-links a:hover{

  color:var(--primary);

}

.nav-links a.active{

  color:var(--primary);

}

.nav-links a.active::after{

  width:100%;

}

.nav-links a::after{

  content:"";

  position:absolute;

  left:0;

  bottom:-7px;

  height:2px;

  width:0;

  background:var(--primary);

  transition:var(--transition);

}

.nav-links a:hover::after{

  width:100%;

}

.book-nav{

  background:var(--navy);

  color:white !important;

  padding:12px 18px;

  border-radius:10px;

}

.book-nav:hover{

  background:var(--primary);

}

.book-nav::after{

  display:none;

}

.menu-btn{

  display:none;

  border:0;

  background:transparent;

  color:var(--navy);

  font-size:24px;

}


/* =========================================================
   HERO
========================================================= */

.hero{

  min-height:790px;

  padding-top:170px;

  position:relative;

  display:flex;

  align-items:center;

  overflow:hidden;

  background:

    linear-gradient(
      90deg,
      rgba(3,17,29,.94) 0%,
      rgba(3,17,29,.75) 42%,
      rgba(3,17,29,.18) 100%
    ),

    url("https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=2200&q=90")
    center/cover no-repeat;

}

.hero::before{

  content:"";

  position:absolute;

  width:550px;

  height:550px;

  right:-220px;

  bottom:-250px;

  border-radius:50%;

  background:rgba(14,165,233,.13);

}

.hero-content{

  position:relative;

  z-index:2;

  color:white;

  max-width:700px;

  padding-bottom:110px;

}

.hero-badge{

  display:inline-flex;

  align-items:center;

  gap:8px;

  padding:9px 15px;

  border-radius:50px;

  background:rgba(255,255,255,.12);

  border:1px solid rgba(255,255,255,.2);

  backdrop-filter:blur(8px);

  font-size:12px;

  font-weight:600;

  margin-bottom:20px;

}

.hero-badge i{

  color:var(--yellow);

}

.hero h1{

  font-size:clamp(43px,6vw,76px);

  line-height:1.05;

  letter-spacing:-2px;

  margin-bottom:22px;

}

.hero h1 span{

  color:var(--yellow);

}

.hero-description{

  max-width:610px;

  color:#e1ebf0;

  font-size:16px;

  margin-bottom:30px;

}

.hero-buttons{

  display:flex;

  align-items:center;

  gap:12px;

  flex-wrap:wrap;

}


/* =========================================================
   BUTTON
========================================================= */

.btn{

  border:0;

  display:inline-flex;

  justify-content:center;

  align-items:center;

  gap:9px;

  padding:14px 21px;

  border-radius:11px;

  font-size:13px;

  font-weight:700;

  transition:var(--transition);

}

.btn-primary{

  background:var(--yellow);

  color:var(--navy);

}

.btn-primary:hover{

  transform:translateY(-3px);

  box-shadow:
    0 12px 30px rgba(255,200,87,.3);

}

.btn-outline{

  color:white;

  background:rgba(255,255,255,.08);

  border:1px solid rgba(255,255,255,.4);

}

.btn-outline:hover{

  background:white;

  color:var(--navy);

}

.btn-blue{

  background:var(--primary);

  color:white;

}

.btn-blue:hover{

  background:var(--primary-dark);

  transform:translateY(-2px);

}


/* =========================================================
   HERO STATS
========================================================= */

.hero-stats{

  display:flex;

  gap:35px;

  margin-top:38px;

  flex-wrap:wrap;

}

.hero-stat{

  display:flex;

  align-items:center;

  gap:10px;

}

.hero-stat-icon{

  width:40px;

  height:40px;

  border-radius:11px;

  background:rgba(255,255,255,.12);

  display:grid;

  place-items:center;

  color:var(--yellow);

}

.hero-stat strong{

  display:block;

  font-size:16px;

}

.hero-stat span{

  display:block;

  color:#b9c9d4;

  font-size:10px;

}


/* =========================================================
   SEARCH
========================================================= */

.search-area{

  position:absolute;

  z-index:10;

  left:50%;

  bottom:-55px;

  transform:translateX(-50%);

  width:min(1080px,90%);

}

.search-box{

  background:white;

  border-radius:18px;

  padding:17px;

  display:grid;

  grid-template-columns:1.4fr 1fr 1fr 1fr auto;

  gap:10px;

  box-shadow:var(--shadow);

}

.search-field{

  min-width:0;

  display:flex;

  align-items:center;

  gap:10px;

  border:1px solid var(--border);

  border-radius:12px;

  padding:10px 12px;

}

.search-field>i{

  color:var(--primary);

}

.search-field label{

  display:block;

  color:var(--muted);

  font-size:9px;

  font-weight:600;

}

.search-field input,
.search-field select{

  width:100%;

  border:0;

  outline:0;

  background:transparent;

  color:var(--text);

  font-size:12px;

  font-weight:600;

}

.search-btn{

  border:0;

  border-radius:12px;

  padding:0 21px;

  background:var(--primary);

  color:white;

  font-weight:800;

  transition:var(--transition);

}

.search-btn:hover{

  background:var(--primary-dark);

}


/* =========================================================
   SECTION
========================================================= */

section{

  padding:100px 0;

}

.section-header{

  text-align:center;

  max-width:700px;

  margin:0 auto 45px;

}

.section-label{

  display:inline-block;

  padding:7px 13px;

  border-radius:50px;

  background:#e8f7fd;

  color:var(--primary-dark);

  font-size:10px;

  font-weight:800;

  letter-spacing:1px;

  text-transform:uppercase;

  margin-bottom:12px;

}

.section-header h2{

  color:var(--navy);

  font-size:clamp(30px,4vw,44px);

  line-height:1.15;

  margin-bottom:12px;

}

.section-header p{

  color:var(--muted);

  font-size:14px;

}


/* =========================================================
   DESTINATIONS
========================================================= */

.destinations{

  padding-top:150px;

}

.destination-grid{

  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:20px;

}

.destination-card{

  height:310px;

  position:relative;

  overflow:hidden;

  border-radius:var(--radius);

  box-shadow:var(--shadow-small);

  cursor:pointer;

}

.destination-card img{

  height:100%;

  transition:.6s ease;

}

.destination-card:hover img{

  transform:scale(1.08);

}

.destination-overlay{

  position:absolute;

  inset:0;

  padding:24px;

  color:white;

  display:flex;

  flex-direction:column;

  justify-content:flex-end;

  background:

    linear-gradient(
      to top,
      rgba(3,16,28,.92),
      rgba(3,16,28,.02) 68%
    );

}

.destination-location{

  color:var(--yellow);

  text-transform:uppercase;

  font-size:10px;

  font-weight:800;

  letter-spacing:.8px;

}

.destination-overlay h3{

  font-size:22px;

  margin:4px 0;

}

.destination-overlay p{

  color:#dbe6ec;

  font-size:12px;

}


/* =========================================================
   PACKAGE SECTION
========================================================= */

.packages{

  background:var(--bg);

}

.package-grid{

  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:22px;

}

.package-card{

  background:white;

  border-radius:var(--radius);

  overflow:hidden;

  box-shadow:var(--shadow-small);

  transition:var(--transition);

}

.package-card:hover{

  transform:translateY(-7px);

  box-shadow:var(--shadow);

}

.package-image{

  height:215px;

  position:relative;

  overflow:hidden;

}

.package-image img{

  height:100%;

  transition:.5s ease;

}

.package-card:hover .package-image img{

  transform:scale(1.07);

}

.package-badge{

  position:absolute;

  top:14px;

  left:14px;

  background:var(--yellow);

  color:var(--navy);

  border-radius:30px;

  padding:6px 10px;

  font-size:9px;

  font-weight:900;

}

.package-body{

  padding:20px;

}

.package-location{

  color:var(--primary-dark);

  font-size:11px;

  font-weight:800;

  margin-bottom:4px;

}

.package-body h3{

  color:var(--navy);

  font-size:19px;

  margin-bottom:7px;

}

.package-body>p{

  color:var(--muted);

  font-size:12px;

  line-height:1.6;

  margin-bottom:15px;

}

.package-meta{

  display:flex;

  gap:16px;

  padding-top:13px;

  margin-bottom:16px;

  border-top:1px solid var(--border);

  color:var(--muted);

  font-size:11px;

}

.package-meta i{

  color:var(--primary);

  margin-right:4px;

}

.package-footer{

  display:flex;

  justify-content:space-between;

  align-items:center;

}

.price small{

  display:block;

  color:var(--muted);

  font-size:9px;

}

.price strong{

  color:var(--navy);

  font-size:21px;

}

.package-btn{

  border:0;

  border-radius:9px;

  padding:10px 13px;

  background:#e9f8ff;

  color:var(--primary-dark);

  font-size:11px;

  font-weight:800;

}

.package-btn:hover{

  background:var(--primary);

  color:white;

}


/* =========================================================
   ABOUT
========================================================= */

.about{

  background:white;

}

.about-grid{

  display:grid;

  grid-template-columns:1fr 1fr;

  gap:70px;

  align-items:center;

}

.about-image{

  height:530px;

  position:relative;

}

.about-image-main{

  height:100%;

  border-radius:26px;

  overflow:hidden;

}

.about-image-main img{

  height:100%;

}

.about-card{

  position:absolute;

  right:-25px;

  bottom:25px;

  background:white;

  padding:17px 20px;

  border-radius:17px;

  box-shadow:var(--shadow);

  display:flex;

  align-items:center;

  gap:11px;

}

.about-card-icon{

  width:43px;

  height:43px;

  background:#fff4d7;

  color:#d79500;

  border-radius:11px;

  display:grid;

  place-items:center;

}

.about-card strong{

  display:block;

  color:var(--navy);

  font-size:20px;

}

.about-card span{

  color:var(--muted);

  font-size:10px;

}

.about-content .section-label{

  margin-bottom:9px;

}

.about-content h2{

  color:var(--navy);

  font-size:clamp(31px,4vw,45px);

  line-height:1.15;

  margin-bottom:16px;

}

.about-content>p{

  color:var(--muted);

  font-size:14px;

  margin-bottom:27px;

}

.feature-grid{

  display:grid;

  grid-template-columns:1fr 1fr;

  gap:19px;

}

.feature{

  display:flex;

  gap:12px;

}

.feature-icon{

  min-width:43px;

  height:43px;

  border-radius:11px;

  background:#e9f8ff;

  color:var(--primary);

  display:grid;

  place-items:center;

}

.feature h4{

  color:var(--navy);

  font-size:13px;

  margin-bottom:2px;

}

.feature p{

  color:var(--muted);

  font-size:10px;

  line-height:1.5;

}


/* =========================================================
   STATS SECTION
========================================================= */

.stats{

  background:var(--navy);

  padding:65px 0;

}

.stats-grid{

  display:grid;

  grid-template-columns:repeat(4,1fr);

}

.stat-box{

  text-align:center;

  color:white;

  padding:10px 20px;

  border-right:1px solid rgba(255,255,255,.1);

}

.stat-box:last-child{

  border-right:0;

}

.stat-box i{

  color:var(--yellow);

  font-size:20px;

  margin-bottom:7px;

}

.stat-box strong{

  display:block;

  font-family:"Poppins",sans-serif;

  font-size:30px;

}

.stat-box span{

  color:#9eb0bc;

  font-size:11px;

}


/* =========================================================
   HOW IT WORKS
========================================================= */

.how{

  background:var(--bg);

}

.steps{

  display:grid;

  grid-template-columns:repeat(4,1fr);

  gap:20px;

  position:relative;

}

.steps::before{

  content:"";

  position:absolute;

  left:13%;

  right:13%;

  top:31px;

  border-top:1px dashed #c9d9e2;

}

.step{

  text-align:center;

  position:relative;

  z-index:2;

}

.step-number{

  width:63px;

  height:63px;

  border-radius:50%;

  background:var(--primary);

  color:white;

  display:grid;

  place-items:center;

  margin:0 auto 18px;

  border:6px solid var(--bg);

  font-size:17px;

  font-weight:800;

  box-shadow:0 0 0 1px #bcd5e0;

}

.step h3{

  color:var(--navy);

  font-size:15px;

  margin-bottom:6px;

}

.step p{

  color:var(--muted);

  font-size:11px;

  max-width:210px;

  margin:auto;

}


/* =========================================================
   GALLERY
========================================================= */

.gallery{

  background:white;

}

.gallery-grid{

  display:grid;

  grid-template-columns:2fr 1fr 1fr;

  grid-template-rows:220px 220px;

  gap:12px;

}

.gallery-item{

  overflow:hidden;

  border-radius:16px;

  position:relative;

}

.gallery-item:first-child{

  grid-row:span 2;

}

.gallery-item img{

  width:100%;

  height:100%;

  transition:.5s ease;

}

.gallery-item:hover img{

  transform:scale(1.07);

}

.gallery-overlay{

  position:absolute;

  inset:0;

  background:linear-gradient(
    to top,
    rgba(0,0,0,.65),
    transparent 60%
  );

  display:flex;

  align-items:flex-end;

  padding:17px;

  color:white;

  font-size:13px;

  font-weight:700;

}


/* =========================================================
   DISCOVER
========================================================= */

.discover{

  padding:90px 0;

}

.discover-box{

  min-height:430px;

  border-radius:27px;

  overflow:hidden;

  position:relative;

  display:flex;

  align-items:center;

  padding:55px;

  background:

    linear-gradient(
      90deg,
      rgba(4,18,30,.92),
      rgba(4,18,30,.46),
      rgba(4,18,30,.05)
    ),

    url("https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1800&q=90")
    center/cover no-repeat;

}

.discover-content{

  max-width:570px;

  color:white;

}

.discover-content .section-label{

  color:var(--yellow);

  background:rgba(255,200,87,.13);

}

.discover-content h2{

  font-size:clamp(32px,4vw,49px);

  line-height:1.1;

  margin-bottom:15px;

}

.discover-content p{

  color:#dfebf1;

  font-size:13px;

  margin-bottom:24px;

}


/* =========================================================
   REVIEWS
========================================================= */

.reviews{

  background:var(--bg);

}

.review-grid{

  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:20px;

}

.review-card{

  background:white;

  border-radius:var(--radius);

  padding:27px;

  box-shadow:var(--shadow-small);

}

.stars{

  color:#f6b51c;

  font-size:13px;

  letter-spacing:1px;

  margin-bottom:14px;

}

.review-card>p{

  color:#536273;

  font-size:13px;

  line-height:1.8;

  margin-bottom:21px;

}

.reviewer{

  display:flex;

  align-items:center;

  gap:11px;

}

.avatar{

  width:43px;

  height:43px;

  border-radius:50%;

  display:grid;

  place-items:center;

  background:#e1f6ff;

  color:var(--primary-dark);

  font-weight:800;

}

.reviewer strong{

  display:block;

  color:var(--navy);

  font-size:12px;

}

.reviewer span{

  color:var(--muted);

  font-size:10px;

}


/* =========================================================
   FAQ
========================================================= */

.faq{

  background:white;

}

.faq-wrapper{

  max-width:800px;

  margin:auto;

}

.faq-item{

  border:1px solid var(--border);

  border-radius:13px;

  margin-bottom:11px;

  overflow:hidden;

}

.faq-question{

  width:100%;

  border:0;

  background:white;

  padding:17px 18px;

  display:flex;

  justify-content:space-between;

  align-items:center;

  text-align:left;

  font-size:13px;

  font-weight:700;

  color:var(--navy);

}

.faq-question i{

  color:var(--primary);

  transition:var(--transition);

}

.faq-answer{

  max-height:0;

  overflow:hidden;

  transition:max-height .3s ease;

}

.faq-answer p{

  padding:0 18px 17px;

  color:var(--muted);

  font-size:12px;

}

.faq-item.active .faq-answer{

  max-height:200px;

}

.faq-item.active .faq-question i{

  transform:rotate(180deg);

}


/* =========================================================
   CTA
========================================================= */

.cta{

  padding:90px 0;

}

.cta-box{

  background:linear-gradient(
    135deg,
    var(--primary),
    #087bb4
  );

  border-radius:26px;

  padding:55px;

  color:white;

  display:flex;

  align-items:center;

  justify-content:space-between;

  gap:30px;

  overflow:hidden;

