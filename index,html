            </p>

            <div class="hero-buttons">
                <a href="#packages" class="btn btn-primary">
                    Explore Packages →
                </a>

                <a href="#booking" class="btn btn-outline">
                    Plan My Trip
                </a>
            </div>

            <div class="hero-stats">

                <div class="stat">
                    <strong>50+</strong>
                    <small>Tour Packages</small>
                </div>

                <div class="stat">
                    <strong>20+</strong>
                    <small>Destinations</small>
                </div>

                <div class="stat">
                    <strong>1K+</strong>
                    <small>Happy Travelers</small>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- DESTINATIONS -->
<section class="destinations" id="destinations">

    <div class="container">

        <div class="section-heading">

            <div>
                <div class="section-label">Explore</div>
