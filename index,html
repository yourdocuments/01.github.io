      position: fixed;
      right: 20px;
      bottom: 20px;
      background: var(--navy);
      color: white;
      padding: 14px 18px;
      border-radius: 12px;
      box-shadow: var(--shadow);
      transform: translateY(100px);
      opacity: 0;
      transition: 0.35s ease;
      z-index: 5000;
      font-size: 13px;
    }

