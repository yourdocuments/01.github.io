                        </div>

                        <a href="#booking" class="details-btn">
                            Book →
                        </a>

                    </div>

                </div>

            </article>


            <!-- PACKAGE 3 -->
            <article class="package-card">

                <div class="package-img">

                    <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1000&q=85">

                    <span class="package-tag">ADVENTURE</span>

                </div>

                <div class="package-info">

                    <div class="package-meta">
                        📍 Sylhet · 2 Days / 1 Night
                    </div>

                    <h3>Green Sylhet Tour</h3>

                    <p>
                        Explore tea gardens, waterfalls and the
                        beautiful countryside of Sylhet.
                    </p>

                    <div class="package-bottom">

                        <div class="price">
                            ৳6,500 <small>/ person</small>
                        </div>

                        <a href="#booking" class="details-btn">
                            Book →
                        </a>

                    </div>

                </div>

            </article>

        </div>

    </div>

</section>


<!-- SERVICES -->
<section class="services" id="services">

    <div class="container">

        <div class="section-heading">

            <div>
                <div class="section-label">What We Do</div>
                <h2>Everything for your journey</h2>
            </div>

            <p>
                We help you plan, book and enjoy your trip without
                unnecessary hassle.
            </p>

