  background:var(--primary);

  color:white;

  font-weight:800;

  font-size:12px;

}

.modal-submit:hover{

  background:var(--primary-dark);

}


/* =========================================================
   TOAST
========================================================= */

.toast{

  position:fixed;

  right:20px;

  bottom:20px;

  z-index:9000;

  background:var(--navy);

  color:white;

  padding:14px 18px;

  border-radius:12px;

  font-size:12px;

  box-shadow:var(--shadow);

  opacity:0;

  transform:translateY(80px);

  pointer-events:none;

  transition:.35s ease;

}

.toast.show{

  opacity:1;

  transform:translateY(0);

}

.toast i{

  color:#4ade80;

}


/* =========================================================
   BACK TO TOP
========================================================= */

.back-top{

  position:fixed;

  right:20px;

  bottom:75px;

  width:42px;

  height:42px;

  border:0;

  border-radius:12px;

