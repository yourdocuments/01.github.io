/* =========================================================
   BOOKING MODAL
========================================================= */

.modal{

  position:fixed;

  inset:0;

  background:rgba(2,12,20,.76);

  backdrop-filter:blur(8px);

  display:none;

  align-items:center;

  justify-content:center;

  padding:20px;

  z-index:5000;

}

.modal.active{

  display:flex;

}

.modal-box{

  width:min(550px,100%);

  max-height:90vh;

  overflow:auto;

  background:white;

  border-radius:23px;

  padding:30px;

  position:relative;

  animation:modalOpen .3s ease;

}

@keyframes modalOpen{

  from{

    opacity:0;

    transform:translateY(20px) scale(.98);

  }

  to{

    opacity:1;

    transform:translateY(0) scale(1);

  }

}

.close-modal{

  position:absolute;

  top:16px;

  right:16px;

  width:36px;

  height:36px;

  border:0;

  border-radius:50%;

  background:#f1f5f7;

  color:var(--navy);

}

.modal-box h2{

  color:var(--navy);

  font-size:25px;

  margin-bottom:4px;

}

.modal-subtitle{

  color:var(--muted);

  font-size:12px;

  margin-bottom:20px;

}

.modal-row{

  display:grid;

  grid-template-columns:1fr 1fr;

  gap:12px;

}

.modal-submit{

  width:100%;

  border:0;

  padding:14px;

