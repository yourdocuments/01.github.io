  <!-- =========================
       JAVASCRIPT
  ========================== -->

  <script>

    /* =========================
       MOBILE MENU
    ========================== */

    const menuBtn = document.getElementById("menuBtn");
    const navLinks = document.getElementById("navLinks");

    menuBtn.addEventListener("click", () => {

      navLinks.classList.toggle("active");

      const icon = menuBtn.querySelector("i");

      if (navLinks.classList.contains("active")) {
        icon.classList.remove("fa-bars");
        icon.classList.add("fa-xmark");
      } else {
        icon.classList.remove("fa-xmark");
        icon.classList.add("fa-bars");
      }

    });


    /* CLOSE MOBILE MENU WHEN CLICK LINK */

    document.querySelectorAll(".nav-links a").forEach(link => {

      link.addEventListener("click", () => {

        navLinks.classList.remove("active");

        const icon = menuBtn.querySelector("i");

        icon.classList.remove("fa-xmark");
        icon.classList.add("fa-bars");

      });

    });


    /* =========================
       BOOKING MODAL
    ========================== */

    const modal = document.getElementById("bookingModal");

    function openBooking(packageName = "") {

      modal.classList.add("active");

      document.body.style.overflow = "hidden";

      if (packageName) {

        const packageSelect =
          document.getElementById("bookingPackage");

        const packageNames = Array.from(
          packageSelect.options
        ).map(option => option.text);

        if (packageNames.includes(packageName)) {
          packageSelect.value = packageName;
        }

        const lowerName = packageName.toLowerCase();

        if (lowerName.includes("cox")) {
          document.getElementById("bookingDestination").value =
            "Cox's Bazar";
        }

        if (lowerName.includes("sajek")) {
          document.getElementById("bookingDestination").value =
            "Sajek Valley";
        }

        if (lowerName.includes("sylhet")) {
          document.getElementById("bookingDestination").value =
            "Sylhet";
        }

        if (lowerName.includes("ratargul")) {
          document.getElementById("bookingDestination").value =
            "Ratargul";
        }

        if (lowerName.includes("bandarban")) {
          document.getElementById("bookingDestination").value =
            "Bandarban";
        }

        if (lowerName.includes("sundarbans")) {
          document.getElementById("bookingDestination").value =
            "Sundarbans";
        }

      }

    }


    function closeBooking() {

      modal.classList.remove("active");

      document.body.style.overflow = "";

    }


    /* CLICK OUTSIDE MODAL */

    modal.addEventListener("click", function(e) {

      if (e.target === modal) {
        closeBooking();
      }

    });


    /* ESCAPE KEY */

    document.addEventListener("keydown", function(e) {

      if (e.key === "Escape") {
        closeBooking();
      }

    });


    /* =========================
       SEARCH FORM
    ========================== */

    const searchForm =
      document.getElementById("searchForm");

    searchForm.addEventListener("submit", function(e) {

      e.preventDefault();

      const destination =
        document.getElementById("destination").value;

      if (!destination) {

        showToast(
          "Please select a destination first."
        );

        return;

      }

      showToast(
        "Searching tours for " + destination + "..."
      );

      setTimeout(() => {

        document
          .getElementById("tours")
          .scrollIntoView({
            behavior: "smooth"
          });

      }, 700);

    });


    /* =========================
       BOOKING FORM
    ========================== */

    const bookingForm =
      document.getElementById("bookingForm");

    bookingForm.addEventListener("submit", function(e) {

      e.preventDefault();

      const name =
        document.getElementById("fullName").value.trim();

      const phone =
        document.getElementById("phone").value.trim();

      const destination =
        document.getElementById("bookingDestination").value;

      const date =
        document.getElementById("bookingDate").value;


      if (!name || !phone || !destination || !date) {

        showToast(
          "Please complete all required fields."
        );

        return;

      }


      closeBooking();

      showToast(
        "Booking request sent successfully!"
      );


      bookingForm.reset();

    });


    /* =========================
       TOAST
    ========================== */

    let toastTimer;

    function showToast(message) {

      const toast =
        document.getElementById("toast");

      const toastMessage =
        document.getElementById("toastMessage");

      toastMessage.textContent = message;

      toast.classList.add("show");

      clearTimeout(toastTimer);

      toastTimer = setTimeout(() => {

        toast.classList.remove("show");

      }, 3000);

    }


    /* =========================
       SET MINIMUM DATE
    ========================== */

    const today =
      new Date().toISOString().split("T")[0];

    document.getElementById("travelDate").min = today;

    document.getElementById("bookingDate").min = today;


    /* =========================
       ACTIVE NAV ON SCROLL
    ========================== */

    const sections =
      document.querySelectorAll("section[id]");

    window.addEventListener("scroll", () => {

      const scrollPosition =
        window.scrollY + 150;

      sections.forEach(section => {

        const top = section.offsetTop;
        const height = section.offsetHeight;
        const id = section.getAttribute("id");

        if (
          scrollPosition >= top &&
          scrollPosition < top + height
        ) {

          document
            .querySelectorAll(".nav-links a")
            .forEach(link => {

              link.classList.remove("active");

              if (
                link.getAttribute("href") === "#" + id
              ) {
                link.classList.add("active");
              }

            });

        }

      });

    });

  </script>

