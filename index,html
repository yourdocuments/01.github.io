<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Neilusha Tour Guide | Explore Bangladesh</title>

  <meta
    name="description"
    content="Neilusha Tour Guide - Discover Bangladesh with unforgettable tours, destinations and local travel experiences."
  />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <!-- Font Awesome -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <style>
    :root {
      --navy: #071a2b;
      --navy-2: #0b263d;
      --blue: #16a8e8;
      --blue-dark: #078ac4;
      --yellow: #ffc857;
      --white: #ffffff;
      --light: #f5f9fc;
      --text: #172333;
      --muted: #718096;
      --border: #e4edf3;
      --shadow: 0 18px 45px rgba(7, 26, 43, 0.11);
      --radius: 20px;
      --transition: 0.3s ease;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", sans-serif;
      color: var(--text);
      background: var(--white);
      line-height: 1.6;
      overflow-x: hidden;
    }

    h1,
    h2,
    h3,
    h4,
    h5 {
      font-family: "Poppins", sans-serif;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button,
    input,
    select {
      font-family: inherit;
    }

    img {
      width: 100%;
      display: block;
      object-fit: cover;
    }

    .container {
      width: min(1180px, 92%);
      margin: auto;
    }

    /* =========================
       TOP BAR
    ========================= */

    .topbar {
      background: var(--navy);
      color: #dceaf3;
      font-size: 13px;
      padding: 9px 0;
    }

    .topbar-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .topbar-left,
    .topbar-right {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .topbar i {
      color: var(--yellow);
      margin-right: 6px;
    }

    /* =========================
       NAVBAR
    ========================= */

    header {
      position: absolute;
      width: 100%;
      top: 38px;
      left: 0;
      z-index: 1000;
    }

    .navbar {
      background: rgba(255, 255, 255, 0.97);
      backdrop-filter: blur(14px);
      border-radius: 16px;
      min-height: 74px;
      padding: 0 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 11px;
      font-family: "Poppins", sans-serif;
      font-weight: 800;
      font-size: 21px;
      color: var(--navy);
      white-space: nowrap;
    }

    .logo-icon {
      width: 43px;
      height: 43px;
      background: var(--blue);
      color: white;
      border-radius: 13px;
      display: grid;
      place-items: center;
      font-size: 19px;
      transform: rotate(-5deg);
    }

    .logo span {
      color: var(--blue-dark);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 27px;
      list-style: none;
    }

    .nav-links a {
      color: #344454;
      font-size: 14px;
      font-weight: 600;
      transition: var(--transition);
      position: relative;
    }

    .nav-links a:hover {
      color: var(--blue);
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -7px;
      width: 0;
      height: 2px;
      background: var(--blue);
      transition: var(--transition);
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .nav-book {
      background: var(--navy);
      color: white !important;
      padding: 12px 18px;
      border-radius: 10px;
    }

    .nav-book:hover {
      background: var(--blue);
    }

    .nav-book::after {
      display: none;
    }

    .menu-btn {
      display: none;
      border: 0;
      background: transparent;
      font-size: 24px;
      cursor: pointer;
      color: var(--navy);
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 760px;
      padding-top: 160px;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(
          90deg,
          rgba(4, 19, 32, 0.90) 0%,
          rgba(4, 19, 32, 0.66) 48%,
          rgba(4, 19, 32, 0.15) 100%
        ),
        url("https://images.unsplash.com/photo-1596895111956-bf1cf0599ce5?auto=format&fit=crop&w=2000&q=85")
        center/cover no-repeat;
    }

    .hero::after {
      content: "";
      position: absolute;
      right: -100px;
      bottom: -180px;
      width: 430px;
      height: 430px;
      border-radius: 50%;
      background: rgba(22, 168, 232, 0.13);
      filter: blur(3px);
    }

    .hero-content {
      position: relative;
      z-index: 2;
      color: white;
      max-width: 680px;
      padding-bottom: 100px;
    }

    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.24);
      backdrop-filter: blur(8px);
      border-radius: 50px;
      padding: 9px 15px;
      font-size: 13px;
      margin-bottom: 20px;
    }

    .hero-tag i {
      color: var(--yellow);
    }

    .hero h1 {
      font-size: clamp(42px, 6vw, 76px);
      line-height: 1.05;
      letter-spacing: -2px;
      margin-bottom: 22px;
    }

    .hero h1 span {
      color: var(--yellow);
    }

    .hero p {
      max-width: 590px;
      color: #e7eef3;
      font-size: 17px;
      margin-bottom: 30px;
    }

    .hero-buttons {
      display: flex;
      gap: 13px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      border: none;
      cursor: pointer;
      padding: 14px 21px;
      border-radius: 11px;
      font-weight: 700;
      font-size: 14px;
      transition: var(--transition);
    }

    .btn-primary {
      background: var(--yellow);
      color: var(--navy);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(255, 200, 87, 0.3);
    }

    .btn-outline {
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.5);
      background: rgba(255, 255, 255, 0.08);
    }

    .btn-outline:hover {
      background: white;
      color: var(--navy);
    }

    /* =========================
       SEARCH BOX
    ========================= */

    .search-wrapper {
      position: absolute;
      z-index: 10;
      bottom: -55px;
      left: 50%;
      transform: translateX(-50%);
      width: min(1080px, 90%);
    }

    .search-box {
      background: white;
      border-radius: 18px;
      padding: 17px;
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr auto;
      gap: 10px;
      box-shadow: var(--shadow);
    }

    .search-field {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 11px 13px;
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .search-field i {
      color: var(--blue);
      font-size: 15px;
    }

    .search-field label {
      display: block;
      font-size: 10px;
      color: var(--muted);
      margin-bottom: 1px;
    }

    .search-field input,
    .search-field select {
      width: 100%;
      border: none;
      outline: none;
      color: var(--text);
      background: transparent;
      font-size: 13px;
      font-weight: 600;
    }

    .search-btn {
      background: var(--blue);
      color: white;
      border: 0;
      padding: 0 22px;
      border-radius: 12px;
      cursor: pointer;
      font-weight: 700;
      transition: var(--transition);
    }

    .search-btn:hover {
      background: var(--blue-dark);
    }

    /* =========================
       SECTION
    ========================= */

    section {
      padding: 105px 0;
    }

    .section-head {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 45px;
    }

    .section-label {
      display: inline-block;
      color: var(--blue-dark);
      background: #e9f8ff;
      padding: 7px 13px;
      border-radius: 30px;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 12px;
    }

    .section-head h2 {
      font-size: clamp(30px, 4vw, 43px);
      line-height: 1.15;
      color: var(--navy);
      margin-bottom: 12px;
    }

    .section-head p {
      color: var(--muted);
      font-size: 15px;
    }

    /* =========================
       DESTINATIONS
    ========================= */

    .destinations {
      padding-top: 145px;
      background: white;
    }

    .destination-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .destination-card {
      position: relative;
      height: 310px;
      overflow: hidden;
      border-radius: var(--radius);
      cursor: pointer;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.07);
    }

    .destination-card img {
      height: 100%;
      transition: transform 0.6s ease;
    }

    .destination-card:hover img {
      transform: scale(1.08);
    }

    .destination-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgba(4, 17, 28, 0.9),
        rgba(4, 17, 28, 0.05) 65%
      );
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 24px;
      color: white;
    }

    .destination-overlay h3 {
      font-size: 22px;
      margin-bottom: 3px;
    }

    .destination-overlay p {
      color: #dce8ef;
      font-size: 13px;
    }

    .destination-location {
      color: var(--yellow);
      font-size: 11px;
      margin-bottom: 5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }

    /* =========================
       TOURS
    ========================= */

    .tours {
      background: var(--light);
    }

    .tour-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .tour-card {
      background: white;
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: 0 7px 28px rgba(7, 26, 43, 0.07);
      transition: var(--transition);
    }

    .tour-card:hover {
      transform: translateY(-7px);
      box-shadow: var(--shadow);
    }

    .tour-image {
      height: 215px;
      position: relative;
      overflow: hidden;
    }

    .tour-image img {
      height: 100%;
      transition: 0.5s ease;
    }

    .tour-card:hover .tour-image img {
      transform: scale(1.06);
    }

    .tour-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      background: var(--yellow);
      color: var(--navy);
      font-size: 11px;
      padding: 6px 10px;
      border-radius: 30px;
      font-weight: 800;
    }

    .tour-body {
      padding: 20px;
    }

    .tour-location {
      color: var(--blue-dark);
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 5px;
    }

    .tour-body h3 {
      font-size: 20px;
      margin-bottom: 8px;
    }

    .tour-description {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 16px;
    }

    .tour-meta {
      display: flex;
      gap: 13px;
      border-top: 1px solid var(--border);
      padding-top: 14px;
      margin-bottom: 16px;
      color: var(--muted);
      font-size: 12px;
    }

    .tour-meta i {
      color: var(--blue);
      margin-right: 4px;
    }

    .tour-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .price small {
      display: block;
      font-size: 10px;
      color: var(--muted);
    }

    .price strong {
      font-size: 22px;
      color: var(--navy);
    }

    .tour-btn {
      background: #eaf8ff;
      color: var(--blue-dark);
      padding: 10px 14px;
      border-radius: 9px;
      border: 0;
      font-weight: 700;
      font-size: 12px;
      cursor: pointer;
      transition: var(--transition);
    }

    .tour-btn:hover {
      background: var(--blue);
      color: white;
    }

    /* =========================
       WHY US
    ========================= */

    .why-us {
      background: white;
    }

    .why-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: center;
    }

    .why-image {
      position: relative;
    }

    .why-image-main {
      height: 520px;
      border-radius: 25px;
      overflow: hidden;
    }

    .why-image-main img {
      height: 100%;
    }

    .experience-box {
      position: absolute;
      bottom: 25px;
      right: -25px;
      background: white;
      border-radius: 17px;
      padding: 18px 22px;
      box-shadow: var(--shadow);
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .experience-icon {
      width: 45px;
      height: 45px;
      border-radius: 12px;
      background: #fff4d8;
      color: #e19a00;
      display: grid;
      place-items: center;
      font-size: 19px;
    }

    .experience-box strong {
      display: block;
      font-size: 21px;
      color: var(--navy);
    }

    .experience-box span {
      font-size: 11px;
      color: var(--muted);
    }

    .why-content .section-label {
      margin-bottom: 10px;
    }

    .why-content h2 {
      font-size: clamp(30px, 4vw, 43px);
      line-height: 1.15;
      color: var(--navy);
      margin-bottom: 16px;
    }

    .why-content > p {
      color: var(--muted);
      font-size: 15px;
      margin-bottom: 28px;
    }

    .feature-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .feature {
      display: flex;
      gap: 13px;
      align-items: flex-start;
    }

    .feature-icon {
      min-width: 44px;
      height: 44px;
      border-radius: 12px;
      background: #e9f8ff;
      color: var(--blue);
      display: grid;
      place-items: center;
    }

    .feature h4 {
      font-size: 14px;
      margin-bottom: 3px;
    }

    .feature p {
      font-size: 11px;
      color: var(--muted);
      line-height: 1.5;
    }

    /* =========================
       HOW IT WORKS
    ========================= */

    .how {
      background: var(--navy);
      color: white;
      position: relative;
      overflow: hidden;
    }

    .how .section-head h2 {
      color: white;
    }

    .how .section-head p {
      color: #aebdca;
    }

    .how .section-label {
      background: rgba(22, 168, 232, 0.15);
      color: #5fc9f4;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      position: relative;
    }

    .steps::before {
      content: "";
      position: absolute;
      top: 31px;
      left: 13%;
      right: 13%;
      height: 1px;
      border-top: 1px dashed rgba(255, 255, 255, 0.25);
    }

    .step {
      text-align: center;
      position: relative;
      z-index: 2;
    }

    .step-number {
      width: 62px;
      height: 62px;
      border-radius: 50%;
      background: var(--blue);
      color: white;
      display: grid;
      place-items: center;
      margin: 0 auto 18px;
      border: 6px solid var(--navy);
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.16);
      font-size: 20px;
      font-weight: 800;
    }

    .step h3 {
      font-size: 16px;
      margin-bottom: 7px;
    }

    .step p {
      color: #aebdca;
      font-size: 12px;
      max-width: 210px;
      margin: auto;
    }

    /* =========================
       BANGLADESH BANNER
    ========================= */

    .discover {
      padding: 90px 0;
    }

    .discover-box {
      min-height: 430px;
      border-radius: 27px;
      overflow: hidden;
      position: relative;
      background:
        linear-gradient(
          90deg,
          rgba(5, 20, 33, 0.91),
          rgba(5, 20, 33, 0.45),
          rgba(5, 20, 33, 0.05)
        ),
        url("https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=1800&q=85")
        center/cover no-repeat;
      display: flex;
      align-items: center;
      padding: 55px;
    }

    .discover-content {
      color: white;
      max-width: 550px;
    }

    .discover-content .section-label {
      background: rgba(255, 200, 87, 0.16);
      color: var(--yellow);
    }

    .discover-content h2 {
      font-size: clamp(32px, 4vw, 49px);
      line-height: 1.12;
      margin-bottom: 14px;
    }

    .discover-content p {
      color: #e1e9ee;
      font-size: 14px;
      margin-bottom: 24px;
    }

    /* =========================
       REVIEWS
    ========================= */

    .reviews {
      background: var(--light);
    }

    .review-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .review-card {
      background: white;
      padding: 26px;
      border-radius: var(--radius);
      box-shadow: 0 6px 25px rgba(7, 26, 43, 0.05);
    }

    .stars {
      color: #f6b51c;
      font-size: 13px;
      margin-bottom: 15px;
    }

    .review-card > p {
      font-size: 14px;
      color: #536273;
      line-height: 1.75;
      margin-bottom: 22px;
    }

    .review-user {
      display: flex;
      gap: 11px;
      align-items: center;
    }

    .avatar {
      width: 43px;
      height: 43px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: #dff5ff;
      color: var(--blue-dark);
      font-weight: 800;
    }

    .review-user strong {
      display: block;
      font-size: 13px;
    }

    .review-user span {
      font-size: 11px;
      color: var(--muted);
    }

    /* =========================
       CTA
    ========================= */

    .cta {
      padding: 90px 0;
      background: white;
    }

    .cta-box {
      background: linear-gradient(135deg, var(--blue), #0a8cc7);
      border-radius: 25px;
      padding: 55px;
      color: white;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 30px;
      position: relative;
      overflow: hidden;
    }

    .cta-box::after {
      content: "";
      position: absolute;
      width: 280px;
      height: 280px;
      border-radius: 50%;
      border: 35px solid rgba(255, 255, 255, 0.08);
      right: -90px;
      top: -120px;
    }

    .cta-content {
      position: relative;
      z-index: 2;
    }

    .cta-content h2 {
      font-size: clamp(27px, 4vw, 40px);
      margin-bottom: 8px;
    }

    .cta-content p {
      color: #e3f7ff;
      font-size: 14px;
    }

    .cta .btn {
      position: relative;
      z-index: 2;
      background: white;
      color: var(--blue-dark);
      white-space: nowrap;
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      background: #04121e;
      color: #b8c7d1;
      padding-top: 65px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
      gap: 45px;
      padding-bottom: 50px;
    }

    .footer-logo {
      color: white;
      margin-bottom: 15px;
    }

    .footer-about {
      font-size: 13px;
      max-width: 300px;
      line-height: 1.8;
      margin-bottom: 20px;
    }

    .socials {
      display: flex;
      gap: 9px;
    }

    .socials a {
      width: 37px;
      height: 37px;
      border-radius: 9px;
      background: rgba(255, 255, 255, 0.07);
      display: grid;
      place-items: center;
      transition: var(--transition);
    }

    .socials a:hover {
      background: var(--blue);
      color: white;
    }

    .footer-col h3 {
      color: white;
      font-size: 15px;
      margin-bottom: 17px;
    }

    .footer-col ul {
      list-style: none;
    }

    .footer-col li {
      margin-bottom: 10px;
      font-size: 12px;
    }

    .footer-col a:hover {
      color: var(--blue);
    }

    .contact-item {
      display: flex;
      gap: 10px;
      margin-bottom: 13px;
      font-size: 12px;
    }

    .contact-item i {
      color: var(--yellow);
      width: 15px;
      margin-top: 4px;
    }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding: 18px 0;
      font-size: 11px;
      display: flex;
      justify-content: space-between;
      gap: 15px;
    }

    /* =========================
       MODAL
    ========================= */

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(2, 12, 20, 0.72);
      backdrop-filter: blur(7px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 3000;
    }

    .modal.active {
      display: flex;
    }

    .modal-box {
      width: min(510px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      background: white;
      border-radius: 22px;
      padding: 28px;
      position: relative;
      animation: modalIn 0.3s ease;
    }

    @keyframes modalIn {
      from {
        opacity: 0;
        transform: translateY(20px) scale(0.98);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .close-modal {
      position: absolute;
      right: 18px;
      top: 17px;
      width: 36px;
      height: 36px;
      border: none;
      background: #f0f4f6;
      border-radius: 50%;
      cursor: pointer;
      color: var(--navy);
    }

    .modal-box h2 {
      color: var(--navy);
      margin-bottom: 6px;
    }

    .modal-subtitle {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 20px;
    }

    .form-group {
      margin-bottom: 14px;
    }

    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      border: 1px solid var(--border);
      padding: 12px 13px;
      border-radius: 10px;
      outline: none;
      font-size: 13px;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--blue);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .submit-booking {
      width: 100%;
      background: var(--blue);
      color: white;
      border: none;
      padding: 14px;
      border-radius: 10px;
      cursor: pointer;
      font-weight: 800;
      margin-top: 4px;
    }

