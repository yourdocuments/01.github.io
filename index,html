<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Neilusha Tour Guide - Explore Bangladesh and beyond with trusted tour guides, travel packages, hotels and transport.">
<title>Neilusha Tour Guide | Explore More</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');

:root{
    --bg:#07110f;
    --bg2:#0c1916;
    --card:#10221d;
    --card2:#142a24;
    --text:#f6f4ed;
    --muted:#a8b5af;
    --accent:#f4c542;
    --accent2:#ffe58a;
    --border:rgba(255,255,255,.09);
    --shadow:0 20px 60px rgba(0,0,0,.3);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:"DM Sans",sans-serif;
    background:var(--bg);
    color:var(--text);
    line-height:1.6;
    overflow-x:hidden;
}

a{
    color:inherit;
    text-decoration:none;
}

button,
input,
select,
textarea{
    font-family:inherit;
}

.container{
    width:min(1180px,92%);
    margin:auto;
}

/* HEADER */

header{
    position:fixed;
    top:0;
    left:0;
    right:0;
    z-index:1000;
    background:rgba(7,17,15,.78);
    backdrop-filter:blur(18px);
    border-bottom:1px solid rgba(255,255,255,.05);
}

.navbar{
    height:78px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    display:flex;
    align-items:center;
    gap:11px;
    font-size:22px;
    font-weight:700;
}

.logo-icon{
    width:42px;
    height:42px;
    display:grid;
    place-items:center;
    border-radius:13px;
    background:var(--accent);
    color:#111;
    font-size:21px;
}

.logo span{
    color:var(--accent);
}

.nav-links{
    display:flex;
    align-items:center;
    gap:30px;
}

.nav-links a{
    color:#d7dfdb;
    font-size:14px;
    font-weight:500;
    transition:.25s;
}

.nav-links a:hover{
    color:var(--accent);
}

.nav-btn{
    padding:11px 19px;
    border-radius:30px;
    background:var(--accent);
    color:#111 !important;
    font-weight:700 !important;
}

.menu-btn{
    display:none;
    border:0;
    background:none;
    color:white;
    font-size:28px;
    cursor:pointer;
}

/* HERO */

.hero{
    min-height:100vh;
    padding-top:78px;
    position:relative;
    display:flex;
    align-items:center;
    overflow:hidden;
    background:
        linear-gradient(90deg,rgba(3,10,8,.96) 0%,rgba(3,10,8,.75) 48%,rgba(3,10,8,.3) 100%),
        url("https://images.unsplash.com/photo-1524492412937-b28074a5d7da?auto=format&fit=crop&w=2000&q=85")
        center/cover;
}

.hero::after{
    content:"";
    position:absolute;
    inset:auto 0 0;
    height:180px;
    background:linear-gradient(transparent,var(--bg));
}

.hero-content{
    position:relative;
    z-index:2;
    max-width:720px;
}

.badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:8px 14px;
    border:1px solid rgba(244,197,66,.3);
    background:rgba(244,197,66,.08);
    color:var(--accent2);
    border-radius:30px;
    font-size:13px;
    margin-bottom:22px;
}

.hero h1{
    font-family:"Playfair Display",serif;
    font-size:clamp(48px,7vw,84px);
    line-height:1.02;
    letter-spacing:-2px;
    margin-bottom:24px;
}

.hero h1 span{
    color:var(--accent);
}

.hero p{
    max-width:590px;
    color:#c2cbc7;
    font-size:17px;
    margin-bottom:32px;
}

.hero-buttons{
    display:flex;
    gap:14px;
    flex-wrap:wrap;
}

.btn{
    border:0;
    cursor:pointer;
    padding:14px 23px;
    border-radius:12px;
    font-size:14px;
    font-weight:700;
    transition:.25s;
}

.btn-primary{
    background:var(--accent);
    color:#111;
}

.btn-primary:hover{
    transform:translateY(-2px);
    background:var(--accent2);
}

.btn-outline{
    border:1px solid rgba(255,255,255,.2);
    background:rgba(255,255,255,.06);
    color:white;
}

.btn-outline:hover{
    background:rgba(255,255,255,.12);
}

.hero-stats{
    display:flex;
    gap:38px;
    margin-top:52px;
}

.stat strong{
    display:block;
    font-size:25px;
    color:var(--accent);
}

.stat small{
    color:#9ca9a4;
}

/* SECTION */

section{
    padding:100px 0;
}

.section-heading{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:30px;
    margin-bottom:42px;
}

.section-label{
    color:var(--accent);
    font-size:12px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:2px;
    margin-bottom:9px;
}

.section-heading h2{
    font-family:"Playfair Display",serif;
    font-size:clamp(34px,5vw,50px);
    line-height:1.1;
}

.section-heading p{
    color:var(--muted);
    max-width:430px;
}

/* DESTINATIONS */

.destinations{
    background:var(--bg);
}

.destination-grid{
    display:grid;
    grid-template-columns:1.3fr 1fr 1fr;
    gap:18px;
}

.destination-card{
    min-height:390px;
    border-radius:20px;
    overflow:hidden;
    position:relative;
    background:#15221f;
}

.destination-card:nth-child(2),
.destination-card:nth-child(3){
    min-height:310px;
}

.destination-card img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.5s;
}

.destination-card:hover img{
    transform:scale(1.06);
}

.destination-overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    justify-content:end;
    padding:25px;
    background:linear-gradient(transparent 30%,rgba(0,0,0,.85));
}

.destination-overlay h3{
    font-family:"Playfair Display",serif;
    font-size:29px;
}

.destination-overlay p{
    color:#c5cfca;
    font-size:13px;
}

/* PACKAGES */

.packages{
    background:var(--bg2);
}

.package-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.package-card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:20px;
    overflow:hidden;
    transition:.3s;
}

.package-card:hover{
    transform:translateY(-7px);
    box-shadow:var(--shadow);
}

.package-img{
    height:225px;
    overflow:hidden;
    position:relative;
}

.package-img img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.5s;
}

.package-card:hover .package-img img{
    transform:scale(1.05);
}

.package-tag{
    position:absolute;
    top:15px;
    left:15px;
    background:var(--accent);
    color:#111;
    font-size:11px;
    font-weight:800;
    padding:6px 10px;
    border-radius:20px;
}

.package-info{
    padding:22px;
}

.package-meta{
    color:var(--muted);
    font-size:12px;
    margin-bottom:8px;
}

.package-info h3{
    font-size:21px;
    margin-bottom:8px;
}

.package-info p{
    color:var(--muted);
    font-size:13px;
    margin-bottom:18px;
}

.package-bottom{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.price{
    color:var(--accent);
    font-size:21px;
    font-weight:700;
}

.price small{
    font-size:11px;
    color:var(--muted);
    font-weight:400;
}

.details-btn{
    padding:9px 14px;
    border:1px solid var(--border);
    border-radius:9px;
    font-size:12px;
}

/* SERVICES */

.services{
    background:var(--bg);
}

.service-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.service{
    padding:28px 22px;
    border:1px solid var(--border);
    border-radius:18px;
    background:linear-gradient(145deg,#10221d,#0b1714);
}

.service-icon{
    width:48px;
    height:48px;
    display:grid;
    place-items:center;
    border-radius:14px;
    background:rgba(244,197,66,.1);
    color:var(--accent);
    font-size:23px;
    margin-bottom:18px;
}

.service h3{
    font-size:17px;
    margin-bottom:8px;
}

.service p{
    color:var(--muted);
    font-size:13px;
}

/* WHY US */

.why{
    background:var(--bg2);
}

.why-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
    align-items:center;
}

.why-image{
    height:520px;
    border-radius:25px;
    overflow:hidden;
}

.why-image img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.features{
    display:grid;
    gap:24px;
}

.feature{
    display:flex;
    gap:16px;
}

.check{
    min-width:38px;
    height:38px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:rgba(244,197,66,.12);
    color:var(--accent);
}

.feature h3{
    margin-bottom:4px;
}

.feature p{
    color:var(--muted);
    font-size:14px;
}

/* BOOKING */

.booking{
    background:
        linear-gradient(rgba(8,20,16,.9),rgba(8,20,16,.96)),
        url("https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1800&q=80")
        center/cover;
}

.booking-box{
    max-width:1000px;
    margin:auto;
    padding:42px;
    border:1px solid var(--border);
    background:rgba(10,24,20,.82);
    backdrop-filter:blur(15px);
    border-radius:25px;
}

.booking-box .section-heading{
    margin-bottom:30px;
}

.booking-form{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
}

.form-group{
    display:flex;
    flex-direction:column;
    gap:7px;
}

.form-group.full{
    grid-column:1/-1;
}

.form-group label{
    font-size:12px;
    color:#aebbb5;
}

.form-group input,
.form-group select,
.form-group textarea{
    width:100%;
    padding:13px 14px;
    border-radius:10px;
    border:1px solid var(--border);
    outline:none;
    background:#0a1714;
    color:white;
}

.form-group textarea{
    min-height:110px;
    resize:vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus{
    border-color:var(--accent);
}

.booking-submit{
    grid-column:1/-1;
}

/* CTA */

.cta{
    padding:80px 0;
}

.cta-box{
    text-align:center;
    padding:70px 30px;
    border-radius:28px;
    background:
        radial-gradient(circle at 50% 0%,rgba(244,197,66,.17),transparent 50%),
        var(--card);
    border:1px solid var(--border);
}

.cta-box h2{
    font-family:"Playfair Display",serif;
    font-size:clamp(35px,5vw,55px);
    margin-bottom:15px;
}

.cta-box p{
    color:var(--muted);
    max-width:600px;
    margin:0 auto 25px;
}

/* FOOTER */

footer{
    border-top:1px solid var(--border);
    padding:55px 0 25px;
    background:#050d0b;
}

.footer-grid{
    display:grid;
    grid-template-columns:1.5fr 1fr 1fr 1fr;
    gap:35px;
    margin-bottom:40px;
}

.footer-brand p{
    color:var(--muted);
    font-size:13px;
    max-width:330px;
    margin-top:15px;
}

footer h4{
    margin-bottom:14px;
}

footer ul{
    list-style:none;
}

footer li{
    margin:9px 0;
}

footer li a{
    color:var(--muted);
    font-size:13px;
}

footer li a:hover{
    color:var(--accent);
}

.footer-bottom{
    border-top:1px solid var(--border);
    padding-top:22px;
    display:flex;
    justify-content:space-between;
    color:#7f8d87;
    font-size:12px;
}

/* FLOATING WHATSAPP */

.whatsapp{
    position:fixed;
    right:22px;
    bottom:22px;
    width:56px;
    height:56px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:#25d366;
    color:white;
    font-size:27px;
    z-index:900;
    box-shadow:0 10px 30px rgba(0,0,0,.4);
}

/* TOAST */

.toast{
    position:fixed;
    left:50%;
    bottom:25px;
    transform:translate(-50%,120px);
    background:#f4c542;
    color:#111;
    padding:13px 20px;
    border-radius:10px;
    font-size:13px;
    font-weight:700;
    z-index:2000;
    transition:.35s;
}

.toast.show{
    transform:translate(-50%,0);
}

/* RESPONSIVE */

@media(max-width:900px){

    .nav-links{
        position:absolute;
        top:78px;
        left:0;
        right:0;
        display:none;
        flex-direction:column;
        align-items:stretch;
        gap:0;
        padding:12px 5%;
        background:#07110f;
        border-bottom:1px solid var(--border);
    }

    .nav-links.active{
        display:flex;
    }

    .nav-links a{
        padding:14px 0;
        border-bottom:1px solid rgba(255,255,255,.05);
    }

    .nav-btn{
        text-align:center;
        margin:8px 0;
    }

    .menu-btn{
        display:block;
    }

    .destination-grid{
        grid-template-columns:1fr 1fr;
    }

    .destination-card:first-child{
        grid-column:1/-1;
    }

    .package-grid{
        grid-template-columns:1fr 1fr;
    }

    .service-grid{
        grid-template-columns:1fr 1fr;
    }

    .why-grid{
        grid-template-columns:1fr;
    }

    .why-image{
        height:400px;
    }

    .footer-grid{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:600px){

    section{
        padding:75px 0;
    }

    .hero{
        min-height:760px;
    }

    .hero h1{
        font-size:50px;
    }

    .hero p{
        font-size:15px;
    }

    .hero-stats{
        gap:20px;
        flex-wrap:wrap;
    }

    .stat strong{
        font-size:20px;
    }

    .section-heading{
        display:block;
    }

    .section-heading p{
        margin-top:15px;
    }

    .destination-grid,
    .package-grid,
    .service-grid{
        grid-template-columns:1fr;
    }

    .destination-card,
    .destination-card:nth-child(2),
    .destination-card:nth-child(3){
        min-height:320px;
    }

    .booking-box{
        padding:25px 18px;
    }

    .booking-form{
        grid-template-columns:1fr;
    }

    .form-group.full,
    .booking-submit{
        grid-column:auto;
    }

    .footer-grid{
        grid-template-columns:1fr;
    }

    .footer-bottom{
        flex-direction:column;
        gap:8px;
    }
}
</style>
</head>

