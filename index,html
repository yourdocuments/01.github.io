            <a href="#booking" class="nav-btn">Book a Tour</a>
        </nav>

        <button class="menu-btn" id="menuBtn">☰</button>

    </div>
</header>


<!-- HERO -->
<section class="hero" id="home">

    <div class="container">

        <div class="hero-content">

            <div class="badge">
                ✈ Trusted Travel & Tour Guide
            </div>

            <h1>
                Discover the world,
                <span>your way.</span>
            </h1>

            <p>
                Explore breathtaking destinations, unforgettable experiences
